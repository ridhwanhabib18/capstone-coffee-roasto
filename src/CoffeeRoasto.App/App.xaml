<Application x:Class="CoffeeRoasto.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- The colours of the three lines in the chart and of their readings. -->
            <SolidColorBrush x:Key="BeanBrush" Color="#D13438" />
            <SolidColorBrush x:Key="DrumBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="ReferenceBrush" Color="#107C10" />
            <SolidColorBrush x:Key="NeutralBrush" Color="#8A6A4F" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
