<ui:FluentWindow x:Class="CoffeeRoasto.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
                  xmlns:c="clr-namespace:CoffeeRoasto.Controls"
                  Title="Coffee Roasto v2.0"
                  Width="1360" Height="860" MinWidth="1180" MinHeight="760"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  WindowCornerPreference="Round"
                  WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <Style x:Key="ActionButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="12,5" />
        </Style>
        <!-- ON / OFF: a tinted fill with coloured text instead of a loud solid colour. -->
        <Style x:Key="SoftOn" TargetType="ui:Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2216A34A" />
            <Setter Property="Foreground" Value="#16A34A" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="MouseOverBackground" Value="#4016A34A" />
            <Setter Property="MouseOverBorderBrush" Value="Transparent" />
            <Setter Property="PressedBackground" Value="#5516A34A" />
            <Setter Property="PressedForeground" Value="#16A34A" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SoftOff" TargetType="ui:Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#22DC2626" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="MouseOverBackground" Value="#40DC2626" />
            <Setter Property="MouseOverBorderBrush" Value="Transparent" />
            <Setter Property="PressedBackground" Value="#55DC2626" />
            <Setter Property="PressedForeground" Value="#DC2626" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Icon="pack://application:,,,/Resources/app.ico" />

        <!-- Header: name, description, connection status and the theme switch. -->
        <Grid Grid.Row="1" Margin="24,4,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Coffee Roasto" FontSize="28" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Border Margin="10,0,0,0" Padding="9,2" CornerRadius="10" VerticalAlignment="Center"
                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock Text="v2.0" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock FontSize="13" Margin="1,2,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="New generation of GUI for Monitoring Temperature Regulation System on Coffee Roaster Machine" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="StatusPill" Padding="12,5" CornerRadius="14" Margin="0,0,12,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Background" Value="#1F22C55E" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <c:LampIndicator IsOn="{Binding IsConnected}" Width="12" Height="12" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ConnectionText}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <ui:Button x:Name="ThemeButton" Icon="{ui:SymbolIcon WeatherMoon24}" Content="Dark"
                           Appearance="Secondary" Click="OnThemeClick" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Left: readings, chart and the three control cards. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Rows="1" Columns="6">
                    <c:KpiTile Title="Bean" Value="{Binding BeanText}" Unit="°C" Accent="{StaticResource BeanBrush}" Margin="0,0,10,0" />
                    <c:KpiTile Title="Drum" Value="{Binding DrumText}" Unit="°C" Accent="{StaticResource DrumBrush}" Margin="0,0,10,0" />
                    <c:KpiTile Title="Reference" Value="{Binding ReferenceText}" Unit="°C" Accent="{StaticResource ReferenceBrush}" Margin="0,0,10,0" />
                    <c:KpiTile Title="Bean − reference" Value="{Binding DeltaText}" Unit="°C" Accent="{StaticResource NeutralBrush}" Margin="0,0,10,0" />
                    <c:KpiTile Title="Rate of rise" Value="{Binding RateText}" Unit="°C/min" Accent="{StaticResource NeutralBrush}" Margin="0,0,10,0" />
                    <c:KpiTile Title="Elapsed" Value="{Binding ElapsedText}" Unit="mm:ss" Accent="{StaticResource NeutralBrush}" />
                </UniformGrid>

                <ui:Card Grid.Row="2" Padding="12" MinHeight="260" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <sp:WpfPlot x:Name="Plot" />
                </ui:Card>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>

                    <!-- Connection -->
                    <ui:Card Grid.Column="0" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Connection" />
                            <TextBlock Text="COM port" Style="{StaticResource RowLabel}" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"
                                          IsEnabled="{Binding IsDisconnected}" />
                                <ui:Button Grid.Column="1" Margin="6,0,0,0" ToolTip="Look for ports again"
                                           Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshPortsCommand}"
                                           IsEnabled="{Binding IsDisconnected}" Appearance="Secondary" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Content="Connect" Appearance="Primary" HorizontalAlignment="Stretch"
                                           Command="{Binding ConnectCommand}" IsEnabled="{Binding IsDisconnected}" />
                                <ui:Button Grid.Column="2" Content="Disconnect" Appearance="Secondary"
                                           HorizontalAlignment="Stretch"
                                           Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Manual control -->
                    <ui:Card Grid.Column="2" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top" IsEnabled="{Binding IsConnected}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Manual control" />
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <c:LampIndicator IsOn="{Binding BurnerLamp}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Burner" Style="{StaticResource RowLabel}" />
                                <ui:Button Grid.Column="2" Content="ON" Style="{StaticResource SoftOn}" Command="{Binding SwitchCommand}" CommandParameter="BurnerOn" />
                                <ui:Button Grid.Column="3" Content="OFF" Margin="6,0,0,0" Style="{StaticResource SoftOff}" Command="{Binding SwitchCommand}" CommandParameter="BurnerOff" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <c:LampIndicator IsOn="{Binding DrumLamp}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Drum motor" Style="{StaticResource RowLabel}" />
                                <ui:Button Grid.Column="2" Content="ON" Style="{StaticResource SoftOn}" Command="{Binding SwitchCommand}" CommandParameter="DrumOn" />
                                <ui:Button Grid.Column="3" Content="OFF" Margin="6,0,0,0" Style="{StaticResource SoftOff}" Command="{Binding SwitchCommand}" CommandParameter="DrumOff" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <c:LampIndicator IsOn="{Binding BlowerLamp}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Blower" Style="{StaticResource RowLabel}" />
                                <ui:Button Grid.Column="2" Content="ON" Style="{StaticResource SoftOn}" Command="{Binding SwitchCommand}" CommandParameter="BlowerOn" />
                                <ui:Button Grid.Column="3" Content="OFF" Margin="6,0,0,0" Style="{StaticResource SoftOff}" Command="{Binding SwitchCommand}" CommandParameter="BlowerOff" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <c:LampIndicator IsOn="{Binding CoolerLamp}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Cooler" Style="{StaticResource RowLabel}" />
                                <ui:Button Grid.Column="2" Content="ON" Style="{StaticResource SoftOn}" Command="{Binding SwitchCommand}" CommandParameter="CoolerOn" />
                                <ui:Button Grid.Column="3" Content="OFF" Margin="6,0,0,0" Style="{StaticResource SoftOff}" Command="{Binding SwitchCommand}" CommandParameter="CoolerOff" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <c:LampIndicator IsOn="{Binding ValveLamp}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Gas valve" Style="{StaticResource RowLabel}" />
                                <ui:Button Grid.Column="2" Content="OPEN" Style="{StaticResource SoftOn}" Command="{Binding SwitchCommand}" CommandParameter="ValveOpen" />
                                <ui:Button Grid.Column="3" Content="CLOSE" Margin="6,0,0,0" Style="{StaticResource SoftOff}" Command="{Binding SwitchCommand}" CommandParameter="ValveClose" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ui:TextBox PlaceholderText="Set point (°C)" Text="{Binding SetpointText, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Grid.Column="1" Content="Send" Appearance="Primary" Margin="6,0,0,0" Command="{Binding SendSetpointCommand}" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Automatic control -->
                    <ui:Card Grid.Column="4" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top" IsEnabled="{Binding IsConnected}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Automatic control" />
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <c:LampIndicator IsOn="{Binding HeatingLamp}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Heating mode" Style="{StaticResource RowLabel}" />
                                <ui:Button Grid.Column="2" Content="ON" Style="{StaticResource SoftOn}" Command="{Binding StartHeatingCommand}" />
                                <ui:Button Grid.Column="3" Content="OFF" Margin="6,0,0,0" Style="{StaticResource SoftOff}" Command="{Binding StopHeatingCommand}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <c:LampIndicator IsOn="{Binding PidLamp}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="PID mode" Style="{StaticResource RowLabel}" />
                                <ui:Button Grid.Column="2" Content="ON" Style="{StaticResource SoftOn}" Command="{Binding StartPidCommand}" />
                                <ui:Button Grid.Column="3" Content="OFF" Margin="6,0,0,0" Style="{StaticResource SoftOff}" Command="{Binding StopPidCommand}" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <c:LampIndicator IsOn="{Binding AutoLamp}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Auto mode" Style="{StaticResource RowLabel}" />
                                <ui:Button Grid.Column="2" Content="ON" Style="{StaticResource SoftOn}" Command="{Binding StartAutoCommand}" />
                                <ui:Button Grid.Column="3" Content="OFF" Margin="6,0,0,0" Style="{StaticResource SoftOff}" Command="{Binding StopAutoCommand}" />
                            </Grid>
                            <TextBlock Text="Reference profile" Style="{StaticResource RowLabel}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ui:TextBox PlaceholderText="Excel file" IsReadOnly="True" Text="{Binding ProfilePath, Mode=OneWay}" />
                                <ui:Button Grid.Column="1" Content="Browse" Margin="6,0,0,0" Appearance="Secondary" Command="{Binding BrowseProfileCommand}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" />
                                <ui:Button Grid.Column="1" Content="Send profile" Margin="6,0,0,0" Appearance="Primary" Command="{Binding SendProfileCommand}" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </Grid>

            <!-- Right: the data table with the recording controls. -->
            <ui:Card Grid.Column="2" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:LampIndicator IsOn="{Binding RecordLamp}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding TableTitle}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" IsEnabled="{Binding IsConnected}">
                        <ui:Button Content="Start" Icon="{ui:SymbolIcon Record24}" Style="{StaticResource SoftOn}" Command="{Binding StartRecordingCommand}" />
                        <ui:Button Content="Stop" Icon="{ui:SymbolIcon Stop24}" Margin="6,0,0,0" Style="{StaticResource SoftOff}" Command="{Binding StopRecordingCommand}" />
                        <ui:Button Content="Export" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Secondary" Margin="6,0,0,0" Command="{Binding ExportRecordingCommand}" />
                    </StackPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding TableSource}" IsReadOnly="True"
                              AutoGenerateColumns="True" HeadersVisibility="Column"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              AlternationCount="2" AutoGeneratingColumn="OnAutoGeneratingColumn" />
                </Grid>
            </ui:Card>
        </Grid>

        <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" />
    </Grid>
</ui:FluentWindow>
