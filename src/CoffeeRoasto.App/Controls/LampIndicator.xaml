<UserControl x:Class="CoffeeRoasto.Controls.LampIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="22" Height="22" VerticalAlignment="Center">
    <!-- A round lamp: dull grey when off, bright green with a soft halo when on. -->
    <Grid>
        <Ellipse x:Name="Halo" Margin="-4" Opacity="0" Fill="#3322C55E" />
        <Ellipse x:Name="Body" Stroke="#40000000" StrokeThickness="1" Fill="#9CA3AF" />
        <Ellipse Margin="4,3,9,10" Opacity="0.55">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
    </Grid>
</UserControl>
