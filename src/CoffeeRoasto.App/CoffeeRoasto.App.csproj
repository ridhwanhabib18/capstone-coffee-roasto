<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <AssemblyName>CoffeeRoasto</AssemblyName>
    <RootNamespace>CoffeeRoasto</RootNamespace>
    <Version>2.0.0</Version>
    <Product>Coffee Roasto</Product>
    <AssemblyTitle>Coffee Roasto v2.0</AssemblyTitle>
    <Description>New generation of GUI for Monitoring Temperature Regulation System on Coffee Roaster Machine</Description>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- ScottPlot pulls in SkiaSharp.Views.WPF, whose .NET Framework build runs fine on .NET 10 (checked with the screenshots and the published exe). -->
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoffeeRoasto.Core\CoffeeRoasto.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
